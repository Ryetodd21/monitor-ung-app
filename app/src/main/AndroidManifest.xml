<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Network -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />

    <!-- Location (coarse only) -->
    <uses-permission android:name="android.permission.ACCESS_COARSE_LOCATION" />

    <!-- Usage Stats (system permission, requested via Settings) -->
    <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS"
        tools:ignore="ProtectedPermissions" />

    <!-- Foreground Service -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Boot & Wake Lock -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />

    <!-- Battery optimization (advisory only) -->
    <uses-permission android:name="android.permission.REQUEST_IGNORE_BATTERY_OPTIMIZATIONS" />

    <!-- Biometric authentication -->
    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:name=".MonitorUNGApplication"
        android:allowBackup="false"
        android:fullBackupContent="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.MonitorUNG"
        android:networkSecurityConfig="@xml/network_security_config"
        tools:targetApi="34">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:theme="@style/Theme.MonitorUNG.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Smart Monitoring Service — the only foreground monitoring service.
             Replaces the legacy .service.MonitoringService (removed 2026-09-26
             — was a notification-only stub, replaced by this one which calls
             real Service.startForeground() anchored to a live notification). -->
        <service
            android:name=".service.SmartMonitoringService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="location" />

        <!-- Round 27 — Firebase Cloud Messaging (FCM) service.
             Receives FCM token refresh events and data messages. The
             service is auto-registered by the firebase-messaging library;
             we declare it here so the OS knows which class handles FCM
             intents. With a placeholder google-services.json, the OS
             still invokes the service on token-refresh events but the
             server-side call fails silently. -->
        <service
            android:name=".data.push.FCMService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- Boot Receiver -->
        <receiver
            android:name=".receiver.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.QUICKBOOT_POWERON" />
            </intent-filter>
        </receiver>

        <!-- Round 28: Geofence BroadcastReceiver. Replaces 45-minute Fused
             Location polling for campus-boundary detection. The receiver
             is exported=false because the system delivers GeofenceEvent
             pending intents; we never accept third-party events here. -->
        <receiver
            android:name=".receiver.GeofenceReceiver"
            android:enabled="true"
            android:exported="false" />

        <!-- WorkManager Initialization -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:selector="androidx.work"
                tools:node="remove" />
        </provider>

    </application>

</manifest>
