            android:pathData="M60,125 L148,125 L148,130 L60,130 Z"/>
        <!-- Bar 2: medium (between leg and diagonal) -->
        <path
            android:fillColor="#FFFFFF"
            android:pathData="M60,95 L148,95 L148,100 L60,100 Z"/>
        <!-- Bar 3: tall (above diagonal peak — key metric) -->
        <path
            android:fillColor="#FFFFFF"
