    <!-- Terms onboarding -->
    <string name="terms_step_terms">Terms</string>
    <string name="terms_step_permissions">Allow</string>
    <string name="terms_header_title">Read me first!</string>
    <string name="terms_header_subtitle">We need your consent before we begin</string>
    <string name="terms_scroll_hint">Scroll down to read everything</string>
    <string name="terms_q1_title">What is this app?</string>
    <string name="terms_q1_body">Monitor UNG helps lecturers and campus admins understand your study habits. The goal is to make teaching at UNG better.</string>
    <string name="terms_q2_title">What data is collected?</string>
    <string name="terms_q2_bullet_1">How long you use your phone each day</string>
    <string name="terms_q2_bullet_2">Which apps you open (social, games, etc.)</string>
    <string name="terms_q2_bullet_3">How many times you unlock the screen</string>
    <string name="terms_q2_bullet_4">Whether you\'re on campus during class hours</string>
    <string name="terms_q3_title">Is location tracked?</string>
    <string name="terms_q3_body">Only coarse location (±100 meters), not precise GPS. We don\'t know which room you\'re in. It only verifies you\'re in the campus area during class hours.</string>
    <string name="terms_q4_title">Is my data safe?</string>
    <string name="terms_q4_bullet_1">Data on your phone is encrypted with a unique key</string>
    <string name="terms_q4_bullet_2">Upload to the server uses HTTPS</string>
    <string name="terms_q4_bullet_3">Only campus admins can see it</string>
    <string name="terms_q4_bullet_4">Never sold or shared with anyone</string>
    <string name="terms_q5_title">You have rights</string>
    <string name="terms_q5_bullet_1">Know exactly what data is collected</string>
    <string name="terms_q5_bullet_2">Request deletion of your data anytime</string>
    <string name="terms_q5_bullet_3">Turn off monitoring via Settings</string>
    <string name="terms_q5_bullet_4">Ask campus admin if anything is unclear</string>
    <string name="terms_warning_title">If you decline</string>
    <string name="terms_warning_body">Monitoring features won\'t run and your data won\'t be sent to the campus server. You can still use the app.</string>
    <string name="terms_checkbox_ready">I have read and agree</string>
    <string name="terms_checkbox_wait">Scroll to the bottom first, then check here</string>
    <string name="terms_decline_button">No, thanks</string>
    <string name="terms_accept_button">Yes, I agree</string>

