    <!-- Terms onboarding -->
    <string name="terms_step_terms">Syarat</string>
    <string name="terms_step_permissions">Izinkan</string>
    <string name="terms_header_title">Baca Dulu, Ya!</string>
    <string name="terms_header_subtitle">Kami butuh persetujuan kamu sebelum mulai</string>
    <string name="terms_scroll_hint">Scroll ke bawah untuk baca semuanya</string>
    <string name="terms_q1_title">Ini Aplikasi Apa?</string>
    <string name="terms_q1_body">Monitor UNG adalah aplikasi untuk bantu dosen dan admin kampus tahu kebiasaan belajar kamu. Tujuannya biar pengajaran di UNG bisa makin baik.</string>
    <string name="terms_q2_title">Data Apa yang Dicatat?</string>
    <string name="terms_q2_bullet_1">Berapa lama kamu pakai HP tiap hari</string>
    <string name="terms_q2_bullet_2">Buka aplikasi apa aja (sosmed, game, dll)</string>
    <string name="terms_q2_bullet_3">Berapa kali buka-tutup HP</string>
    <string name="terms_q2_bullet_4">Kamu ada di kampus atau nggak saat jam kuliah</string>
    <string name="terms_q3_title">Lokasi Dicatat?</string>
    <string name="terms_q3_body">Cuma lokasi kasar (±100 meter), bukan lokasi GPS akurat. Kami nggak tahu kamu ada di ruangan mana. Fungsinya cuma memastikan kamu beneran di area kampus pas jam kuliah.</string>
    <string name="terms_q4_title">Aman Nggak Data Kami?</string>
    <string name="terms_q4_bullet_1">Data di HP kamu dienkripsi (kunci khusus)</string>
    <string name="terms_q4_bullet_2">Kirim ke server pakai jalur terenkripsi (HTTPS)</string>
    <string name="terms_q4_bullet_3">Cuma admin kampus yang bisa lihat</string>
    <string name="terms_q4_bullet_4">Nggak dijual atau diberikan ke siapa pun</string>
    <string name="terms_q5_title">Kamu Punya Hak</string>
    <string name="terms_q5_bullet_1">Tahu data apa aja yang dikumpulkan</string>
    <string name="terms_q5_bullet_2">Minta hapus data kamu kapan aja</string>
    <string name="terms_q5_bullet_3">Matikan fitur pemantauan lewat menu Setelan</string>
    <string name="terms_q5_bullet_4">Tanya ke admin kampus kalau ada yang bingung</string>
    <string name="terms_warning_title">Kalau Pilih Tidak Setuju</string>
    <string name="terms_warning_body">Fitur pemantauan nggak akan jalan dan data kamu nggak dikirim ke server kampus. Tapi kamu tetap bisa pakai aplikasi ini.</string>
    <string name="terms_checkbox_ready">Saya sudah baca dan saya setuju</string>
